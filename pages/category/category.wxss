.c-head {
  background: linear-gradient(180deg, #E3F4F8 0%, #F7F7F7 100%);
  padding: 36rpx 32rpx 28rpx;
}
.c-head__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
}
.c-head__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6f8a94;
}
.c-head__search {
  margin-top: 26rpx;
}

.c-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 20rpx 40rpx;
}
.c-item {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  padding: 30rpx 26rpx;
  background: #ffffff;
  border-radius: 20rpx;
  min-height: 150rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.c-item__name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #111111;
}
.c-item__count {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #2C8CAB;
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
}
