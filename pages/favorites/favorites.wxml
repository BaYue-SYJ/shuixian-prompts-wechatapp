<view class="page">

  <view class="f-head">
    <view>
      <view class="f-head__title">我的收藏</view>
      <view class="f-head__sub">{{list.length}} 条</view>
    </view>
    <text wx:if="{{list.length > 0}}" class="f-head__clear" bindtap="clearAll">清空</text>
  </view>

  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view data-id="{{item.id}}" bindtap="goDetail" hover-class="btn--hover">
        <view class="card__title">{{item.title}}</view>
        <view class="card__excerpt">{{item.excerpt}}</view>
      </view>
      <view class="card__foot">
        <text class="tag">{{item.cat}}</text>
        <text class="f-remove" data-id="{{item.id}}" catchtap="removeOne">移除</text>
      </view>
    </view>

    <view class="state" wx:if="{{list.length === 0}}">
      <text class="state__title">还没有收藏</text>
      在提示词详情页点「☆ 收藏」，就会出现在这里
      <view class="btn btn--ghost f-empty__btn" bindtap="goIndex" hover-class="btn--hover">去逛逛</view>
    </view>
  </view>

</view>
