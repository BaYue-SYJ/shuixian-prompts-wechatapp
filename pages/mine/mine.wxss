.m-head {
  background: linear-gradient(180deg, #E3F4F8 0%, #F7F7F7 100%);
  padding: 56rpx 32rpx 44rpx;
  text-align: center;
}
.m-head__logo {
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: #2C8CAB;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.m-head__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111111;
}
.m-head__sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6f8a94;
}

.m-stat {
  display: flex;
  margin: -20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 0;
}
.m-stat__cell {
  flex: 1;
  text-align: center;
}
.m-stat__n {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C8CAB;
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
}
.m-stat__l {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8b969c;
}

.m-group {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
}
.m-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f2f5f6;
}
.m-row:last-child { border-bottom: none; }
.m-row__k {
  font-size: 28rpx;
  color: #111111;
}
.m-row__v {
  font-size: 25rpx;
  color: #b0b9be;
}

.m-note {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
}
.m-note__t {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #2C8CAB;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.m-note__p {
  font-size: 25rpx;
  line-height: 1.8;
  color: #6d787e;
  margin-bottom: 12rpx;
}
.m-note__p--dim { color: #a3adb3; margin-bottom: 0; }
.m-note__hl { color: #2C8CAB; font-weight: 600; }

.m-foot {
  padding: 40rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bcc4c9;
}
