.detail {
  padding: 0 0 200rpx;
}

.d-head {
  background: #ffffff;
  padding: 36rpx 32rpx 28rpx;
}
.d-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.42;
  color: #111111;
}
.d-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.d-id {
  font-size: 23rpx;
  color: #b6c0c6;
}

.d-body {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 28rpx 36rpx;
}
.d-label {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #2C8CAB;
  font-weight: 600;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #eef3f5;
  margin-bottom: 24rpx;
}
.d-prompt {
  display: block;
  font-size: 28rpx;
  line-height: 1.85;
  color: #2f3a40;
  white-space: pre-wrap;
  word-break: break-word;
}

.d-skeleton__line {
  height: 26rpx;
  background: #eef2f4;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.d-skeleton__line--short { width: 55%; }
.d-skeleton__tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #a9b3b9;
}

.d-error {
  padding: 30rpx 0;
  text-align: center;
}
.d-error__msg {
  display: block;
  font-size: 26rpx;
  color: #9aa4ab;
  margin-bottom: 26rpx;
}
.d-retry {
  width: 260rpx;
  height: 72rpx;
  margin: 0 auto;
}

/* 底部固定操作条 */
.d-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 32rpx calc(18rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, .96);
  border-top: 1rpx solid #eef2f4;
}
.d-bar__fav {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 88rpx;
  border-radius: 20rpx;
  color: #9aa4ab;
  font-size: 32rpx;
  line-height: 1.1;
}
.d-bar__fav--on {
  color: #2C8CAB;
  background: #E3F4F8;
}
.d-bar__favtxt {
  font-size: 20rpx;
  margin-top: 4rpx;
}
.d-bar__copy {
  flex: 1;
}

.d-cover {
  display: block;
  width: 100%;
  margin: 20rpx 24rpx 0;
  background: #eef2f4;
  border-radius: 20rpx;
}
