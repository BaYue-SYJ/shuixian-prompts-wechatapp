.hero {
  background: linear-gradient(180deg, #E3F4F8 0%, #F7F7F7 100%);
  padding: 36rpx 32rpx 28rpx;
}
.hero__row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.hero__title {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #111111;
}
.hero__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6f8a94;
}
.hero__dice {
  padding: 12rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #cfe6ee;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #2C8CAB;
}
.hero__search {
  margin-top: 26rpx;
}

.chips--wrap {
  padding: 24rpx 32rpx 8rpx;
  background: #F7F7F7;
}

.list {
  padding: 12rpx 24rpx 40rpx;
}
.list__count {
  padding: 8rpx 8rpx 16rpx;
  font-size: 23rpx;
  color: #a3adb3;
}
.card__go {
  font-size: 24rpx;
  color: #2C8CAB;
}

.card__cover {
  display: block;
  width: 100%;
  height: 220rpx;
  margin: -28rpx -28rpx 22rpx;
  background: #eef2f4;
  border-radius: 20rpx 20rpx 0 0;
}
